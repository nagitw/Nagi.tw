---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource/noto-sans-tc/400.css';
import '@fontsource/noto-sans-tc/500.css';
import '../styles/studio.css';
import { localeFromPath, localizePath, translate, withBase } from '../lib/i18n';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  contentLanguage?: 'en' | 'zh-TW';
  hasTranslation?: boolean;
}
const {
  title,
  description,
  noindex = false,
  contentLanguage,
  hasTranslation = false,
} = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const language = contentLanguage ?? locale;
const canonical = new URL(localizePath(Astro.url.pathname, locale), Astro.site);
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#09090b"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline>
      // Apply appearance before the first paint; CSS also works without JavaScript.
      const systemAppearance = matchMedia('(prefers-color-scheme: dark)');
      const applyAppearance = (preference) => {
        const theme =
          preference === 'light' || preference === 'dark'
            ? preference
            : 'system';
        document.documentElement.dataset.theme = theme;
        const dark =
          theme === 'dark' || (theme === 'system' && systemAppearance.matches);
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((meta) => {
            meta.setAttribute('content', dark ? '#09090b' : '#fafafa');
          });
      };
      let savedAppearance = 'system';
      try {
        savedAppearance = localStorage.getItem('nagi-theme');
      } catch {
        /* Storage is optional. */
      }
      applyAppearance(savedAppearance);
      systemAppearance.addEventListener('change', () =>
        applyAppearance(document.documentElement.dataset.theme),
      );
      document.addEventListener('DOMContentLoaded', () => {
        const control = document.getElementById('theme');
        if (!(control instanceof HTMLSelectElement)) return;
        control.value = document.documentElement.dataset.theme;
        control.disabled = false;
        control.addEventListener('change', () => {
          applyAppearance(control.value);
          try {
            localStorage.setItem('nagi-theme', control.value);
          } catch {
            /* Switching still works on this page. */
          }
        });
      });
    </script>
    <title>{title} — Nagi.tw</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/nagi.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={locale === 'en' ? 'Nagi.tw Journal' : 'Nagi.tw 札記'}
      href={withBase(locale === 'en' ? '/rss.xml' : '/zh/rss.xml')}
    />
    {!noindex &&
      (!contentLanguage || hasTranslation ? (
        <>
          <link
            rel="alternate"
            hreflang="en"
            href={new URL(localizePath(Astro.url.pathname, 'en'), canonical)}
          />
          <link
            rel="alternate"
            hreflang="zh-TW"
            href={new URL(localizePath(Astro.url.pathname, 'zh-TW'), canonical)}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(localizePath(Astro.url.pathname, 'en'), canonical)}
          />
        </>
      ) : (
        <link rel="alternate" hreflang={contentLanguage} href={canonical} />
      ))}
    <meta property="og:title" content={`${title} — Nagi.tw`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:locale"
      content={language === 'en' ? 'en_US' : 'zh_TW'}
    />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex, follow" />}
  </head>
  <body id="top">
    <a class="skip" href="#main">
      {translate(locale, 'Skip to content', '跳至主要內容')}
    </a>
    <div class="shell">
      <Header
        article={!!contentLanguage && !hasTranslation}
        notFound={noindex}
      />
      <main
        id="main"
        tabindex="-1"
        data-pagefind-body={!noindex || undefined}
        data-pagefind-ignore={noindex || undefined}
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
