---
import ContentIndex from '../components/ContentIndex.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Penguin from '../components/Penguin.astro';
import { getSite } from '../data/site';
import { content } from '../lib/content';
import { projectEntries, researchGroups, developmentLabels } from '../lib/catalog';
import { localPath, type Locale } from '../i18n/ui';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const site = getSite(locale);
const research = researchGroups(content, locale).flatMap(group => group.entries).slice(0, 3);
const projects = projectEntries(content, locale).slice(0, 3);
---
<BaseLayout locale={locale} title={zh ? 'Nagi — 資安、系統與研究筆記' : 'Nagi — Security, systems & research notes'} description={site.introduction}>
  <header class="studio-hero editorial-hero">
    <div class="hero-copy"><p class="eyebrow">Nagi.tw / Penguin Interactive Studio</p>
      <h1>{zh ? '保持好奇，' : 'Stay curious.'}<br />{zh ? '留下紀錄' : 'Leave a record'}<span>.</span></h1>
      <p class="focus-line">{site.focus}</p>
      <p class="intro">{site.introduction}</p>
      <div class="hero-actions"><a class="primary-link" href={localPath('/journal/', locale)}>{zh ? '閱讀日誌' : 'Read the journal'} <span aria-hidden="true">↗</span></a><a href={localPath('/research/', locale)}>{zh ? '探索研究' : 'Explore research'} <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="hero-companion"><Penguin large label={zh ? '認識企鵝：開啟 Penguin AI' : 'Meet the penguin: open Penguin AI'} /><p class="meta">Penguin Interactive Studio</p><p>{zh ? '安靜地建立，仔細地記錄。' : 'Build quietly. Document carefully.'}</p></div>
  </header>
  <section class="section" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">{zh ? '最新文章' : 'Latest Writing'}<span class="heading-english">01 / WRITING</span></h2><a href={localPath('/journal/', locale)}>{zh ? '全部文章' : 'All writing'} →</a></div>
    <ContentIndex kinds={['journal']} locale={locale} limit={3} />
  </section>
  <section class="section" aria-labelledby="research-title">
    <div class="section-heading"><h2 id="research-title">{zh ? '精選研究' : 'Featured Research'}<span class="heading-english">02 / RESEARCH</span></h2><a href={localPath('/research/', locale)}>{zh ? '所有研究' : 'All research'} →</a></div>
    {research.length ? research.map(entry => <article class="record"><p class="meta">{entry.typeLabel}</p><h3><a href={localPath(entry.path, entry.record.locale as Locale)} lang={entry.record.locale === 'zh' ? 'zh-TW' : 'en'}>{entry.title}</a></h3><p>{entry.record.description}</p>{entry.phase && <p class="meta">{entry.phase}</p>}</article>) : <p class="empty-state">{zh ? '目前尚無已發布的研究紀錄。' : 'No published research yet.'}</p>}
  </section>
  <section class="section" aria-labelledby="projects-title">
    <div class="section-heading"><h2 id="projects-title">{zh ? '精選專案' : 'Selected Projects'}<span class="heading-english">03 / PROJECTS</span></h2><a href={localPath('/projects/', locale)}>{zh ? '所有專案' : 'All projects'} →</a></div>
    {projects.length ? projects.map(entry => <article class="record"><p class="meta">{entry.developmentStatus ? developmentLabels[entry.developmentStatus][locale] : entry.phase || entry.typeLabel}</p><h3><a href={localPath(entry.path, entry.record.locale as Locale)} lang={entry.record.locale === 'zh' ? 'zh-TW' : 'en'}>{entry.title}</a></h3><p>{entry.record.description}</p><ul class="tools" aria-label={zh ? '使用技術' : 'Technologies'}>{entry.tools.map(tool => <li>{tool}</li>)}</ul></article>) : <p class="empty-state">{zh ? '目前尚無已發布的專案紀錄。' : 'No published projects yet.'}</p>}
  </section>
  <section class="section about-preview" aria-labelledby="about-title"><p class="eyebrow">04 / ABOUT</p><h2 id="about-title">{zh ? '你好，我是 Nagi。' : "Hello, I’m Nagi."}</h2><p class="intro">{site.introduction}</p><a href={localPath('/about/', locale)}>{zh ? '關於我與這個網站' : 'About me & this site'} →</a></section>
</BaseLayout>
