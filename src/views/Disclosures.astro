---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicDisclosures } from '../data/disclosures';
import { getPublicDisclosures } from '../lib/disclosures';
import { localPath, type Locale } from '../i18n/ui';
interface Props { locale: Locale; id?: string; year?: string }
const { locale, id, year } = Astro.props;
const copy = {
  en: {
    title: 'Security disclosures', intro: 'Verified security findings published with explicit authorization, with references to the public review and remediation record.',
    empty: 'No authorized public disclosures are available yet.', emptyDetail: 'This index contains no demonstration findings or placeholder disclosure IDs. Records will appear only after verification and authorization for public disclosure.',
    all: 'All years', category: 'Category', allCategories: 'All categories', severity: 'Severity', workflow: 'Review workflow', status: 'Vulnerability status', published: 'Published', references: 'Public references', detail: 'Disclosure details', back: 'All disclosures', unavailable: 'Disclosure unavailable', unavailableBody: 'There is no authorized public record at this address.',
    process: 'Publication policy', processBody: 'Draft, Merged and Published describe editorial review and publication. Verified, Remediated, and Public Disclosure describe the vulnerability lifecycle. A merged change alone does not establish verification, remediation, or permission to disclose.',
    scope: 'Records use ZD-YYYY-xxxxx identifiers, Web or IoT categories, and Low, Medium, or High severity. Only verified findings with explicit publication authorization and public GitHub PR or commit references appear here.',
    low: 'Low', medium: 'Medium', high: 'High', merged: 'Merged', public: 'Public Disclosure', pr: 'Pull request', commit: 'Commit', noMatches: 'No disclosures match this category.',
  },
  zh: {
    title: '資安漏洞揭露', intro: '經驗證且獲得明確公開授權的資安發現，附上公開審查與修復紀錄。',
    empty: '目前沒有已獲授權的公開揭露紀錄。', emptyDetail: '此索引不使用示範漏洞或占位編號。完成驗證並取得公開揭露授權後，才會刊登紀錄。',
    all: '所有年份', category: '分類', allCategories: '所有分類', severity: '嚴重程度', workflow: '審查流程', status: '漏洞狀態', published: '公開日期', references: '公開參考資料', detail: '揭露詳情', back: '所有揭露紀錄', unavailable: '無可用的揭露紀錄', unavailableBody: '此網址沒有已獲授權的公開紀錄。',
    process: '公開政策', processBody: '草稿（Draft）、已合併（Merged）與已發布（Published）描述內容審查及發布流程；已驗證（Verified）、已修復（Remediated）與公開揭露（Public Disclosure）描述漏洞生命週期。合併變更不代表漏洞已驗證、已修復，或已取得公開授權。',
    scope: '紀錄採用 ZD-YYYY-xxxxx 編號，分類為 Web 或 IoT，嚴重程度為低、中、高。僅刊登已驗證、明確獲得公開授權，且附公開 GitHub PR 或 commit 參考資料的紀錄。',
    low: '低', medium: '中', high: '高', merged: '已合併', public: '公開揭露', pr: '合併請求', commit: '提交紀錄', noMatches: '此分類目前沒有揭露紀錄。',
  },
}[locale];
const records = getPublicDisclosures(publicDisclosures);
const years = [...new Set(records.map((record) => record.year))].sort().reverse();
const selected = id ? records.find((record) => record.id === id) : undefined;
const visible = year ? records.filter((record) => record.year === year) : records;
const severityLabel = { Low: copy.low, Medium: copy.medium, High: copy.high };
const root = '/security/disclosures/';
const title = id ? selected?.title[locale] ?? copy.unavailable : `${copy.title}${year ? ` · ${year}` : ''}`;
---
<BaseLayout locale={locale} title={title} description={selected?.summary[locale] ?? copy.intro}>
  <header class="page-heading"><p class="eyebrow">{locale === 'zh' ? '資安研究' : 'Security research'}</p><h1>{title}</h1><p class="intro">{selected?.summary[locale] ?? copy.intro}</p></header>
  {id ? selected ? <article class="detail-record">
    <p class="meta">{selected.id} · {selected.category}</p>
    <dl class="disclosure-metadata">
      <div><dt>{copy.severity}</dt><dd>{severityLabel[selected.severity]}</dd></div>
      <div><dt>{copy.workflow}</dt><dd>{locale === 'zh' ? '已發布' : 'Published'}</dd></div>
      <div><dt>{copy.status}</dt><dd>{locale === 'zh' ? ({ Verified: '已驗證', Remediated: '已修復', 'Public Disclosure': '公開揭露' }[selected.status]) : selected.status}</dd></div>
      <div><dt>{copy.published}</dt><dd><time datetime={selected.publishedAt}>{selected.publishedAt}</time></dd></div>
    </dl>
    <h2>{copy.detail}</h2>{selected.details[locale].map((paragraph) => <p>{paragraph}</p>)}
    <h2>{copy.references}</h2><ul>{selected.references.map((ref) => <li><a href={ref.url}>{ref.kind === 'PR' ? copy.pr : copy.commit}: {ref.url}</a></li>)}</ul>
    <a href={localPath(root, locale)}>{copy.back}</a>
  </article> : <section class="studio-panel"><h2>{copy.unavailable}</h2><p>{copy.unavailableBody}</p><a href={localPath(root, locale)}>{copy.back}</a></section> : <>
    {years.length > 0 && <nav class="year-links" aria-label={locale === 'zh' ? '依年份瀏覽' : 'Browse by year'}><a href={localPath(root, locale)} aria-current={!year ? 'page' : undefined}>{copy.all}</a>{years.map((value) => <a href={localPath(`${root}year/${value}/`, locale)} aria-current={year === value ? 'page' : undefined}>{value}</a>)}</nav>}
    {visible.length > 0 ? <section data-disclosure-list>
      <label for="disclosure-category">{copy.category}</label>
      <select id="disclosure-category" data-disclosure-category><option value="all">{copy.allCategories}</option><option value="Web">Web</option><option value="IoT">IoT</option></select>
      {visible.map((record) => <article class="detail-record" data-category={record.category}>
        <p class="meta">{record.id} · {record.category} · {copy.severity}: {severityLabel[record.severity]}</p>
        <h2><a href={localPath(`${root}${record.id}/`, locale)}>{record.title[locale]}</a></h2>
        <p>{record.summary[locale]}</p><p class="meta">{copy.public} · <time datetime={record.publishedAt}>{record.publishedAt}</time></p>
      </article>)}
      <p data-no-disclosures hidden role="status">{copy.noMatches}</p>
    </section> : <section class="studio-panel"><h2>{copy.empty}</h2><p>{copy.emptyDetail}</p></section>}
    <section class="detail-record"><h2>{copy.process}</h2><p>{copy.processBody}</p><p>{copy.scope}</p></section>
  </>}
</BaseLayout>
<script>
  document.querySelectorAll<HTMLElement>('[data-disclosure-list]').forEach((list) => {
    list.querySelector<HTMLSelectElement>('[data-disclosure-category]')?.addEventListener('change', (event) => {
      const category = (event.target as HTMLSelectElement).value;
      let count = 0;
      list.querySelectorAll<HTMLElement>('[data-category]').forEach((record) => {
        record.hidden = category !== 'all' && record.dataset.category !== category;
        if (!record.hidden) count++;
      });
      const empty = list.querySelector<HTMLElement>('[data-no-disclosures]');
      if (empty) empty.hidden = count > 0;
    });
  });
</script>
<style>
  .year-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
  .year-links [aria-current] { font-weight: 700; }
  select { margin-inline-start: .75rem; padding: .5rem; color: inherit; background: var(--surface, transparent); border: 1px solid currentColor; border-radius: .4rem; }
  .disclosure-metadata { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
  .disclosure-metadata dt { font-weight: 600; }
  .disclosure-metadata dd { margin: .3rem 0 0; }
  article a { overflow-wrap: anywhere; }
</style>
