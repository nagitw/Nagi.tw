---
import leads from '../data/project-leads.json';
import { localPath } from '../i18n/ui';
import ContentIndex from '../components/ContentIndex.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../data/projects';
import { ui, type Locale } from '../i18n/ui';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = ui[locale];
const projects = getProjects(locale);

---
<BaseLayout locale={locale} title={copy.projects} description={copy.projectsDescription}>
  <header class="page-heading"><p class="eyebrow">{copy.projects}</p><h1>{copy.projects}</h1><p class="intro">{copy.projectsIntro}</p></header>
  {projects.map((project) => <article class="detail-record" id={project.id}>
    <p class="meta">{project.category} · {project.status}</p><h2>{project.title}</h2>
    <p class="question">{project.summary}</p><p>{project.details}</p>
    {project.tools.length > 0 && <ul class="tools" aria-label={`${project.title} ${copy.technologies}`}>{project.tools.map((tool) => <li>{tool}</li>)}</ul>}
    {project.limitations.length > 0 && <aside class="scope" aria-label={`${project.title} ${copy.limitations}`}><h3>{copy.limitations}</h3><ul>{project.limitations.map((limitation) => <li>{limitation}</li>)}</ul></aside>}
  </article>)}
<ContentIndex locale={locale} kinds={['project']} />
<section class="section"><h2>{locale === 'zh' ? '專案資料待補充' : 'Project documentation pending'}</h2><p>{locale === 'zh' ? '以下名稱是待整理線索；沒有足夠公開資料時，不列為已完成成果。' : 'These names are documentation leads, not completed achievements.'}</p>{leads.map(project => <article class="record"><h3><a href={localPath(`/projects/${project.slug}/`, locale)}>{project.name}</a></h3></article>)}</section>
</BaseLayout>
