---
import ContentIndex from '../components/ContentIndex.astro';
import JournalIndex from '../components/JournalIndex.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../data/site';
import { localPath, type Locale } from '../i18n/ui';
interface Props { locale?: Locale; page: string }
const { locale = 'en', page } = Astro.props;
const zh = locale === 'zh'; const site = getSite(locale);
const titles: Record<string, string> = { journal: zh ? '學習日誌' : 'Journal', 'technical-reports': zh ? '技術報告' : 'Technical Reports', about: zh ? '關於 Nagi' : 'About Nagi' };
const descriptions: Record<string, string> = {
  journal: zh ? '資安、醫療、人生觀點與心得，依日期閱讀。' : 'Cybersecurity, medical, perspectives and reflections, in date order.',
  'technical-reports': zh ? '讓方法、證據與限制可以被重新檢視。' : 'Methods, evidence and limitations, written to be revisited.',
  about: zh ? '安靜地建立系統，仔細地留下紀錄。' : 'Build quietly. Document carefully.',
};
---
<BaseLayout locale={locale} title={titles[page]!} description={descriptions[page]!}>
  <header class="page-heading"><p class="eyebrow">Penguin Interactive Studio / {titles[page]}</p><h1>{titles[page]}</h1><p class="intro">{descriptions[page]}</p></header>
  {page === 'about' && <>
    <section class="studio-panel"><p class="eyebrow">Hello, I'm Nagi.</p><h2>{site.name}</h2><p class="intro">{site.introduction}</p><blockquote>{zh ? '把你要讓它存在的東西，親手創造出來。' : 'If you want something to exist, build it yourself.'}</blockquote><p>{zh ? '先釐清問題，再選擇工具；透過實作讓想法可以被測試，以紀錄說明方法、證據與限制。企鵝陪著我保持好奇，把每一次探索留下來。' : 'Understand the problem before choosing tools. Build to test ideas, and document methods, evidence and limitations. The penguin is a companion for this curious practice.'}</p><a href={localPath('/experience/', locale)}>{zh ? '經歷與學習軌跡' : 'Experience & learning'} →</a></section>
    <section class="section"><h2>{zh ? '一起交流' : 'Start a conversation'}</h2><p>{zh ? '透過公開筆記、專案與聯絡頁認識我的工作。' : 'Explore the public notes and projects, or get in touch.'}</p><a href={localPath('/contact/', locale)}>{zh ? '聯絡 Nagi' : 'Contact Nagi'} →</a></section>
  </>}
  {page === 'journal' && <section><div class="section-heading"><h2>{zh ? '最新筆記' : 'Latest Journal'}</h2><a href={site.notes}>Notes ↗</a></div></section>}
  {page === 'journal' && <JournalIndex locale={locale} />}
  {page === 'technical-reports' && <ContentIndex locale={locale} kinds={['report']} />}
</BaseLayout>
