---
import BaseLayout from '../layouts/BaseLayout.astro';
import { edition, content } from '../lib/content';
import { prepareArticle } from '../lib/article';
import ArticleTools from '../components/ArticleTools.astro';
import ReadingMeta from '../components/ReadingMeta.astro';
import { journalEntries, journalCategories } from '../lib/journal';
import { localPath, type Locale } from '../i18n/ui';
import { catalogEntries, developmentLabels, fields } from '../lib/catalog';
import RelatedRecords from '../components/RelatedRecords.astro';
import WorkFacts from '../components/WorkFacts.astro';
import '../styles/work.css';
interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const record = edition(path, locale);
const original = record ?? content.find(r => r.route.replace(/^\/zh(?=\/)/, '') === path)!;
const zh = locale === 'zh';
const title = record?.title ?? `${zh ? '翻譯待補充' : 'Translation pending'} · ${original.title}`;
const description = record?.description || (zh ? 'Nagi 的公開紀錄；原文中的狀態與限制保留供讀者查閱。' : 'A public Nagi record with the original scope and limitations.');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const availableLocales = content.filter(r => r.route.replace(/^\/zh(?=\/)/, '') === path).map(r => r.locale as Locale);
const project = record?.kind === 'project' ? catalogEntries(content, locale, ['project']).find(entry => entry.path === path) : undefined;
const rendered = record ? await prepareArticle(record.body, base, locale) : undefined;
const journal = journalEntries(content, locale).sort((a, b) => (b.record.date ?? '').localeCompare(a.record.date ?? '') || a.path.localeCompare(b.path));
const currentIndex = record?.kind === 'journal' ? journal.findIndex(entry => entry.path === path) : -1;
const neighbors = currentIndex < 0 ? [] : [journal[currentIndex - 1], journal[currentIndex + 1]];
const current = journal[currentIndex];
const dossier = catalogEntries(content, locale, ['project', 'research', 'lab', 'report']).find(entry => entry.path === path);
---
<BaseLayout article={true} locale={locale} availableLocales={availableLocales} title={`${title} · ${zh ? '紀錄' : 'Record'} · ${path.split('/').filter(Boolean).at(-1)}`} description={description}>
<div class="article-layout">
<header class="page-heading"><p class="eyebrow">{project ? fields[project.field][locale] : zh ? '公開紀錄' : 'Public record'}</p><h1>{project?.title ?? title}</h1><p>{description}</p>
  {project && <nav class="work-nav" aria-label={zh ? '專案導覽' : 'Project navigation'}><a href={localPath('/projects/', locale)}><span aria-hidden="true">←</span> {zh ? '所有專案' : 'All projects'}</a><a href={localPath('/research/', locale)}>{zh ? '研究紀錄' : 'Research records'} <span aria-hidden="true">→</span></a></nav>}
</header>
{dossier && <p class="meta">{dossier.typeLabel}{record?.date && <> · <time datetime={record.date}>{record.date}</time></>}{dossier.phase && <> · {dossier.phase}</>}</p>}
{project && <WorkFacts entry={project} locale={locale} />}
{project && (project.tools.length > 0 || project.phase || project.developmentStatus) && <section class="project-context" aria-label={zh ? '專案概覽' : 'Project overview'}>
  {project.developmentStatus && <p class="work-status">{zh ? '開發狀態：' : 'Development: '}{developmentLabels[project.developmentStatus][locale]}</p>}
  {project.phase && <p class="work-phase">{project.phase}</p>}
  {project.tools.length > 0 && <><h2>{zh ? '使用技術' : 'Technologies'}</h2><ul class="work-tags">{project.tools.map(tool => <li>{tool}</li>)}</ul></>}
</section>}
{project && (project.record.github || project.record.demo) && <div class="work-actions">{project.record.github && <a href={project.record.github}>GitHub ↗</a>}{project.record.demo && <a href={project.record.demo}>{zh ? '展示' : 'Demo'} ↗</a>}</div>}
{record ? <>
<ReadingMeta body={record.body} date={record.date} category={current ? journalCategories[current.category][locale] : undefined} locale={locale} />
<ArticleTools headings={rendered!.headings} locale={locale} />
<p class="meta">{zh ? '作者：Nagi · 內容保留原始紀錄時的狀態，不代表目前成果已獨立驗證。' : 'By Nagi · Historical source statements are not independently verified outcomes.'}</p>
{record.cover && <img src={`${base}${record.cover}`} alt={record.title} width="800" height="394" loading="lazy" class="article-cover" decoding="async" />}
<article class="article-body" id="article-body" set:html={rendered!.html} />
{rendered!.references.length > 0 && <section class="article-references" id="article-references" aria-labelledby="references-title"><h2 id="references-title">{zh ? '參考資料' : 'References'}</h2><p class="meta">{zh ? '本文引用的外部連結' : 'External sources linked in this article'}</p><ol>{rendered!.references.map(ref => <li><a href={ref.href} rel="noreferrer">{ref.text}</a></li>)}</ol></section>}
</> : <section class="studio-panel"><h2>{zh ? '這篇內容尚無繁體中文版' : 'This article has no English edition yet'}</h2><p>{zh ? '目前只提供原始語言版本，不以自動翻譯替代原文。' : 'The original edition is available. A translation has not been published.'}</p><a href={localPath(path, original.locale as Locale)}>{zh ? '閱讀原文' : 'Read original'}</a></section>}
<RelatedRecords path={path} locale={locale} />
{neighbors.some(Boolean) && <nav class="article-neighbors" aria-label={zh ? '上下篇文章' : 'Adjacent articles'}>{neighbors.map((entry, index) => entry && <a href={localPath(entry.path, entry.record.locale as Locale)}><span class="meta">{index === 0 ? (zh ? '較新一篇' : 'Newer article') : (zh ? '較早一篇' : 'Older article')}</span><span lang={entry.record.locale === 'zh' ? 'zh-TW' : 'en'}>{entry.title}</span></a>)}</nav>}
<a href={localPath('/journal/', locale)}>{zh ? '瀏覽日誌' : 'Browse journal'}</a>
</div>
</BaseLayout>
