---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResearch } from '../data/research';
import { ui, localPath, type Locale } from '../i18n/ui';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = ui[locale];
const research = getResearch(locale);

---
<BaseLayout locale={locale} title={copy.research} description={copy.researchDescription}>
  <header class="page-heading"><p class="eyebrow">Research</p><h1>{copy.research}</h1><p class="intro">{copy.researchIntro}</p></header>
  <article class="studio-panel"><p class="eyebrow">Research series · {locale === 'zh' ? '規劃中' : 'Planned'}</p><h2>From CTF to OSCP</h2><p>{locale === 'zh' ? '以成對的學習日誌與技術報告整理每個 Episode。尚未發布實驗成果或證照。' : 'Each episode pairs a learning journal with a technical report. Results and certification are not claimed.'}</p><a href={localPath('/research/from-ctf-to-oscp/', locale)}>{locale === 'zh' ? '探索研究系列' : 'Explore the series'} →</a></article>
  {research.map((item) => <article class="detail-record" id={item.id}>
    <p class="meta">{item.status}</p><h2>{item.title}</h2>
    {item.question && <p class="question">{item.question}</p>}
    <p>{item.summary}</p>
    {item.href && <a class="record-link" href={localPath(item.href, locale)}>{item.linkLabel} <span aria-hidden="true">→</span></a>}
  </article>)}
</BaseLayout>
