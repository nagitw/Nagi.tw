---
import ContentIndex from '../components/ContentIndex.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResearch } from '../data/research';
import { ui, localPath, type Locale } from '../i18n/ui';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = ui[locale];
const research = getResearch(locale);

---
<BaseLayout locale={locale} title={copy.research} description={copy.researchDescription}>
  <header class="page-heading"><p class="eyebrow">{copy.research}</p><h1>{copy.research}</h1><p class="intro">{copy.researchIntro}</p></header>
  {research.map((item) => <article class="detail-record" id={item.id}>
    <p class="meta">{item.status}</p><h2>{item.title}</h2>
    {item.question && <p class="question">{item.question}</p>}
    <p>{item.summary}</p>
    {item.href && <a class="record-link" href={localPath(item.href, locale)}>{item.linkLabel} <span aria-hidden="true">→</span></a>}
  </article>)}
<ContentIndex locale={locale} kinds={['research', 'lab']} />
</BaseLayout>