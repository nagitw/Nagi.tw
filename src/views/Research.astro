---
import WorkCard from '../components/WorkCard.astro';
import RelatedRecords from '../components/RelatedRecords.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResearch } from '../data/research';
import { content } from '../lib/content';
import { researchGroups } from '../lib/catalog';
import '../styles/work.css';
import { ui, localPath, type Locale } from '../i18n/ui';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = ui[locale];
const research = getResearch(locale);
const groups = researchGroups(content, locale);
const primary = research.find(item => item.id === 'medical-iot');
const directions = research.filter(item => item.id !== 'medical-iot');
const zh = locale === 'zh';

---
<BaseLayout locale={locale} title={copy.research} description={copy.researchDescription}>
  <header class="page-heading"><p class="eyebrow">Penguin Interactive Studio / {zh ? '問題、方法與紀錄' : 'Questions, methods & records'}</p><h1>{copy.research}</h1><p class="intro">{copy.researchIntro}</p>
    <nav class="work-nav" aria-label={zh ? '研究延伸閱讀' : 'Explore research records'}><a href={localPath('/projects/', locale)}>{zh ? '工程專案' : 'Engineering projects'} <span aria-hidden="true">↗</span></a><a href={localPath('/journal/', locale)}>{zh ? '學習日誌' : 'Journal'} <span aria-hidden="true">→</span></a><a href={localPath('/technical-reports/', locale)}>{zh ? '技術報告' : 'Technical reports'} <span aria-hidden="true">→</span></a></nav>
  </header>
  {primary && <section class="research-question" id="medical-iot" aria-labelledby="research-question"><p class="eyebrow">{primary.status}</p><h2 id="research-question">{primary.question}</h2><p>{primary.summary}</p>{primary.href && <a href={localPath(primary.href, locale)}>{primary.linkLabel} <span aria-hidden="true">→</span></a>}</section>}
  {groups.length > 0 ? <>
    <nav aria-label={zh ? '依研究領域閱讀' : 'Browse research fields'}><ul class="field-nav">{groups.map(group => <li><a href={`#${group.id}`}>{group.label}<span aria-label={zh ? `${group.entries.length} 篇紀錄` : `${group.entries.length} records`}>{group.entries.length}</span></a></li>)}</ul></nav>
    {groups.map(group => <section class="work-section" id={group.id} aria-labelledby={`${group.id}-title`}><div class="work-section-heading"><h2 id={`${group.id}-title`}>{group.label}</h2><p>{zh ? '方法、觀察與限制' : 'Methods, observations & limitations'}</p></div><div class="work-grid">{group.entries.map(entry => <WorkCard entry={entry} locale={locale} />)}</div>{group.id === 'iot-security' && <RelatedRecords path="/research/archive-notes/" locale={locale} />}</section>)}
  </> : <p class="work-empty">{zh ? '目前尚無已發布的研究紀錄。' : 'No research records have been published yet.'}</p>}
  {directions.length > 0 && <details class="research-directions"><summary>{zh ? '持續探索的方向' : 'Directions still being explored'}</summary>{directions.map(item => <article id={item.id}><h3>{item.title}</h3><p class="meta">{item.status}</p><p>{item.summary}</p></article>)}</details>}
</BaseLayout>
