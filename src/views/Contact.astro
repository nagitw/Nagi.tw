---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../data/site';
import { ui, type Locale } from '../i18n/ui';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = ui[locale];
const site = getSite(locale);

---
<BaseLayout locale={locale} title={copy.contact} description={copy.contactDescription}>
  <header class="page-heading"><p class="eyebrow">Contact</p><h1>{copy.contact}</h1><p class="intro">{copy.contactIntro}</p></header>
  <dl class="contact-list">
    <div><dt>{copy.email}</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
    <div><dt>GitHub</dt><dd><a href={site.github}>seraphforge <span aria-hidden="true">↗</span></a></dd></div>
    <div><dt>{copy.notes}</dt><dd><a href={site.notes}>notes.nagi.tw <span aria-hidden="true">↗</span></a></dd></div>
  </dl>
</BaseLayout>
