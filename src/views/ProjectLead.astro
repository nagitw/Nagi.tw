---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localPath, type Locale } from '../i18n/ui';
interface Props { locale: Locale; project: { name: string; slug: string; evidence: boolean } }
const { locale, project } = Astro.props; const zh = locale === 'zh';
const pending = zh ? '待補充：尚未找到足以刊登的專案資料。' : 'Pending: sufficient publishable project documentation was not found.';
---
<BaseLayout locale={locale} title={project.name} description={project.evidence ? (zh ? 'Nagi 的公開技術與生活筆記。' : 'Public technical and personal notes by Nagi.') : pending}>
<header class="page-heading"><p class="eyebrow">{zh ? '專案資料待補充' : 'Project documentation pending'}</p><h1>{project.name}</h1><p>{project.evidence ? (zh ? '公開文章已整合至本站日誌，原始筆記網站繼續保留。' : 'Public articles are integrated into this journal. The original Notes site remains available.') : pending}</p></header>
<dl>{(zh ? ['專案背景','技術架構','使用技術','開發狀態','已驗證成果','GitHub 連結'] : ['Background','Architecture','Technologies','Development status','Verified results','GitHub repository']).map(label => <div class="record"><dt>{label}</dt><dd>{zh ? '待補充公開資料；未宣稱完成或驗證。' : 'Public documentation pending; no completion or verification claimed.'}</dd></div>)}</dl>
{project.evidence && <p><a href="https://notes.nagi.tw/">Nagi Notes ↗</a></p>}
<p><a href={localPath('/journal/',locale)}>{zh ? '公開日誌' : 'Public journal'}</a></p><a href={localPath('/projects/',locale)}>{zh ? '返回專案' : 'Back to projects'}</a>
</BaseLayout>
