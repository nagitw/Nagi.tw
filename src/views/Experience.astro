---
import ContentIndex from '../components/ContentIndex.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExperience } from '../data/experience';
import { ui, type Locale } from '../i18n/ui';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = ui[locale];
const experience = getExperience(locale);
const years = [...new Set(experience.map((entry) => entry.year))].sort().reverse();
const zh = locale === 'zh';
const categories: Record<string, string> = zh
  ? { competitions: '競賽', ctf: 'CTF', training: '研習／培訓', conferences: '研討會', speaking: '演講', teaching: '教學' }
  : { competitions: 'Competitions', ctf: 'CTF', training: 'Training / Workshops', conferences: 'Conferences', speaking: 'Speaking', teaching: 'Teaching' };
---
<BaseLayout locale={locale} title={copy.experience} description={copy.experienceDescription}>
  <header class="page-heading"><p class="eyebrow">{copy.experience}</p><h1>{copy.experience}</h1><p class="intro">{copy.experienceIntro}</p></header>
  <label class="experience-filter">{zh ? '活動分類' : 'Activity category'} <select id="experience-category"><option value="all">{zh ? '全部' : 'All'}</option>{Object.entries(categories).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
  <p id="experience-empty" role="status" hidden>{zh ? '此分類目前沒有已公開紀錄。' : 'No published records in this category.'}</p>
  {years.map((year) => <section class="section" data-experience-year aria-labelledby={`year-${year}`}>
    <div class="section-heading"><h2 id={`year-${year}`}>{year}</h2></div>
    {(['dated', 'year'] as const).map(precision => {
      const items = experience.filter(entry => entry.year === year && (precision === 'year' ? entry.datePrecision === 'year' : entry.datePrecision !== 'year'));
      return items.length > 0 && <section data-experience-group><h3>{precision === 'year' ? (zh ? '日期未詳' : 'Date unspecified') : (zh ? '已知日期／月份' : 'Known date / month')}</h3>{items.map(entry => <article class="experience-row" data-category={entry.category} data-event-year={entry.year} data-date-precision={entry.datePrecision}>
        <span class="meta">{entry.eventDate ?? entry.year}</span><div><p class="meta">{categories[entry.category]}</p><h4>{entry.title}</h4><p>{entry.role}{entry.organization && ` · ${entry.organization}`}</p>
        {entry.award && <p>{zh ? '獎項' : 'Award'} · {entry.award}</p>}
        {entry.placement !== undefined && <p>{entry.rankingUnit === 'team' ? (zh ? '團隊排名' : 'Team rank') : entry.rankingUnit === 'individual' ? (zh ? '個人排名' : 'Individual rank') : (zh ? '排名（單位未詳）' : 'Rank (unit unspecified)')} · {entry.placement}{entry.totalParticipants !== undefined && ` / ${entry.totalParticipants}`}</p>}
        {entry.team && <p>{entry.team}</p>}
        {entry.evidenceUrls?.filter(url => /^https?:\/\//.test(url)).map((url, index) => <a href={url} rel="noopener noreferrer">{zh ? '證據' : 'Evidence'} {index + 1}</a>)}
        </div>
      </article>)}</section>;
    })}
  </section>)}
<ContentIndex locale={locale} kinds={['experience']} />
</BaseLayout>
<style>
  .experience-filter { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  select { max-width: 100%; padding: .6rem; color: var(--text); background: var(--bg); border: 1px solid var(--line); border-radius: .5rem; font: inherit; }
  .experience-row { grid-template-columns: minmax(4rem, 7rem) minmax(0, 1fr); overflow-wrap: anywhere; }
  [hidden] { display: none !important; }
  @media (max-width: 480px) { .experience-row { grid-template-columns: 1fr; gap: .5rem; } }
</style>
<script>
  const filter = document.querySelector<HTMLSelectElement>('#experience-category');
  filter?.addEventListener('change', () => {
    document.querySelectorAll<HTMLElement>('.experience-row[data-category]').forEach(row => {
      row.hidden = filter.value !== 'all' && row.dataset.category !== filter.value;
    });
    document.querySelectorAll<HTMLElement>('[data-experience-group], [data-experience-year]').forEach(group => {
      group.hidden = !group.querySelector('.experience-row:not([hidden])');
    });
    const empty = document.querySelector<HTMLElement>('#experience-empty');
    if (empty) empty.hidden = !!document.querySelector('.experience-row:not([hidden])');
  });
</script>
