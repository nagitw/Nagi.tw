---
import type { PreviewGroup } from '../lib/previews';
import { formatDate } from '../lib/previews';
import { ui, type Locale } from '../i18n/ui';
interface Props { groups: PreviewGroup[]; locale?: Locale }
const { groups, locale = 'en' } = Astro.props;
const copy = ui[locale];
---
{groups.length ? (
  <div class="notes-list">
    {groups.map(({ variants }) => {
      const article = variants.zh;
      return <article class="note-row">
        <time class="meta" datetime={article.data.date.toISOString()}>{formatDate(article.data.date, locale)}</time>
        <div lang="zh-TW">
          <h3><a href={article.href}>{article.data.title}</a></h3>
          {article.data.description && <p>{article.data.description}</p>}
        </div>
      </article>;
    })}
  </div>
) : <p class="notes-fallback">{copy.notesUnavailable} <a href="https://notes.nagi.tw/">{copy.readNotes} ↗</a></p>}
<style>
  .note-row { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; padding: 1.3rem 0; border-bottom: 1px solid var(--line); }
  h3 { font-size: .95rem; font-weight: 500; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  p { color: var(--muted); font-size: .82rem; margin: .4rem 0 0; }
  .notes-fallback { margin-top: 1.25rem; }
  @media (max-width: 767px) { .note-row { grid-template-columns: 1fr; gap: .4rem; } }
</style>
