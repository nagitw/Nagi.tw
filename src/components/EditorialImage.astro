---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  eager?: boolean;
}
const { src, alt, caption, eager = false } = Astro.props;
---

<figure>
  <Image
    src={src}
    alt={alt}
    width={src.width}
    height={src.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    widths={[...new Set([480, 800, 1200, 1600, src.width])].filter(
      (width) => width <= src.width,
    )}
    sizes="(max-width: 48rem) 100vw, 70ch"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
