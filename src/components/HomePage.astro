---
import Layout from '../layouts/Layout.astro';
import ContentCard from '../components/ContentCard.astro';
import { getFeatured, preferLocale } from '../lib/content';
import { localeFromPath, localizePath, translate } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = (en: string, zh: string) => translate(locale, en, zh);
const featured = preferLocale(await getFeatured(), locale);
const sections = [{title:'Projects',note:t("Cybersecurity and engineering projects, from idea to implementation.","從想法到實作，留下過程與選擇。")},{title:'Research',note:t("Research questions and proposed directions.","研究問題與提案方向。")},{title:'Journal',note:t("Notes on security, engineering, and everyday observations.","記錄日常裡值得停留的片刻。")}];
---
<Layout title={t("Home", "首頁")} description={t("Nagi.tw — a personal cybersecurity and engineering website. Projects, research, and notes.", "Nagi.tw — 記錄資安與工程專案、研究及觀察的個人網站。")}>
<section class="hero"><p class="eyebrow">{t("Nagi.tw / Cybersecurity & engineering","Nagi.tw / 資安與工程")}</p><h1>{t("Room to think.", "留白思考。")}<br />{t("Space to create.", "動手創造。")}</h1><p class="intro">{t("A portfolio on cybersecurity and software engineering, starting with open-source work on the reliability of command-line tools.","這裡記錄資安與軟體工程的實作，從改善開源命令列工具的可靠性開始。")}</p><a class="text-link" href={localizePath("/about/", locale)}>{t("About this space ↗","關於這個空間 ↗")}</a></section>
<section class="section"><h2>{t("An ongoing collection.","持續累積的紀錄。")}</h2><div class="grid">{sections.map(item => <article class="card"><h3><a href={localizePath(`/${item.title.toLowerCase()}/`, locale)}>{t(item.title, item.title === "Projects" ? "專案" : item.title === "Research" ? "研究" : "札記")} ↗</a></h3><p>{item.note}</p></article>)}</div></section>
<section class="section" aria-labelledby="featured-title"><h2 id="featured-title">{t("Featured.","精選。")}</h2>{featured.length > 0 ? <div class="grid">{featured.map(entry => <ContentCard entry={entry} />)}</div> : <p class="muted">{t("Featured work is being prepared. Explore the collections in the meantime.","精選內容整理中。可先從各個分類開始瀏覽。")}</p>}</section>
<section class="section"><h2>{t("Notes beyond the screen.","螢幕之外的觀察。")}</h2><p class="intro">{t("A wider perspective, through photography and experience.","用影像觀察，以經歷累積視角。")}</p><div class="link-row"><a class="text-link" href={localizePath("/photography/", locale)}>{t("Photography ↗", "攝影 ↗")}</a><a class="text-link" href={localizePath("/experience/", locale)}>{t("Experience ↗", "經歷 ↗")}</a></div></section>
</Layout>
