---
import { getNavigation, getSite } from '../data/site';
import { ui, localPath, withoutBase, type Locale } from '../i18n/ui';
interface Props { locale?: Locale; availableLocales?: Locale[] }
const { locale = 'en', availableLocales = ['en', 'zh'] } = Astro.props;
const copy = ui[locale];
const site = getSite(locale);
const navigation = ['/journal/', '/research/', '/projects/', '/experience/', '/about/'].map(path => getNavigation(locale).find(link => link.href === localPath(path, locale))!);
const englishPath = withoutBase(Astro.url.pathname).replace(/^\/zh(?=\/|$)/, '') || '/';
const path = Astro.url.pathname.replace(/\/?$/, '/');
---
<header class="sidebar">
  <a class="brand" href={localPath('/', locale)} aria-label={`Nagi.tw ${copy.overview}`}>nagi<span>.tw</span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" hidden>{copy.menu}</button>
  <nav id="site-navigation" aria-label={copy.navigation}>
    <ul class="nav-list">
      {navigation.map(({ href, label }) => <li><a href={href} aria-current={path === href || path.startsWith(href) ? 'page' : undefined}>{label}</a></li>)}
    </ul>
    <div class="sidebar-language">
      {availableLocales.includes(locale === 'zh' ? 'en' : 'zh') ? <a data-language-switch href={localPath(englishPath, locale === 'zh' ? 'en' : 'zh')} lang={locale === 'zh' ? 'en' : 'zh-TW'} hreflang={locale === 'zh' ? 'en' : 'zh-TW'}>{locale === 'zh' ? 'English' : '中文'}</a> : <span class="meta">{locale === 'zh' ? '尚無英文版' : 'Chinese edition unavailable'}</span>}
    </div>
    <div class="sidebar-external">
      <a href={site.notes}>{copy.notes} <span aria-hidden="true">↗</span><span class="sr-only">{copy.external}</span></a>
      <a href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
  <div class="sidebar-bottom">
    <button id="theme-toggle" type="button" aria-pressed="false" hidden>{copy.darkMode}</button>
  </div>
</header>
<script>
  document.querySelector<HTMLAnchorElement>('[data-language-switch]')?.addEventListener('click', (event) => {
    const link = event.currentTarget as HTMLAnchorElement;
    try { localStorage.setItem('nagi-language', link.lang === 'en' ? 'en' : 'zh'); } catch {}
    link.hash = location.hash;
  });
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-navigation');
  const mobile = window.matchMedia('(max-width: 767px)');
  if (menu && nav) {
    menu.hidden = false;
    const setOpen = (open: boolean) => {
      menu.setAttribute('aria-expanded', String(open));
      nav.hidden = mobile.matches && !open;
    };
    setOpen(false);
    menu.addEventListener('click', () => setOpen(menu.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.matches && menu.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        menu.focus();
      }
    });
    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a') && mobile.matches) setOpen(false);
    });
    mobile.addEventListener('change', () => {
      if (mobile.matches && nav.contains(document.activeElement)) menu.focus();
      setOpen(false);
    });
  }
  const theme = document.querySelector<HTMLButtonElement>('#theme-toggle');
  if (theme) {
    theme.hidden = false;
    theme.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
    theme.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme !== 'dark';
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      theme.setAttribute('aria-pressed', String(dark));
      try { localStorage.setItem('nagi-theme', dark ? 'dark' : 'light'); } catch { /* Theme still works without persistence. */ }
    });
  }
</script>
