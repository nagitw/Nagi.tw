---
import { fields, developmentLabels, relatedEntries, type CatalogEntry } from '../lib/catalog';
import { content } from '../lib/content';
import { localPath, type Locale } from '../i18n/ui';
import WorkFacts from './WorkFacts.astro';
interface Props { entry: CatalogEntry; locale: Locale }
const { entry, locale } = Astro.props;
const zh = locale === 'zh';
const lang = entry.record.locale === 'zh' ? 'zh-TW' : 'en';
const related = entry.record.kind === 'project' ? relatedEntries(content, entry.path, locale) : [];
---
<article class:list={['work-card', `work-card--${entry.record.kind}`]} data-work-card>
  <div class="work-card-meta"><span>{fields[entry.field][locale]}</span><span class="work-type">{entry.typeLabel}</span></div>
  <h3><a class="work-card-link" href={localPath(entry.path, entry.record.locale as Locale)} lang={lang}>{entry.title}<span class="card-arrow" aria-hidden="true">↗</span></a></h3>
  {entry.record.description && <p class="work-summary" lang={lang}>{entry.record.description}</p>}
  {entry.record.locale !== locale && <p class="edition-note">{zh ? '尚無繁體中文版；閱讀英文原文。' : 'Chinese original · English edition not yet available.'}</p>}
  {entry.tools.length > 0 && <ul class="work-tags" aria-label={zh ? '使用技術' : 'Technologies'}>{entry.tools.map(tool => <li>{tool}</li>)}</ul>}
  {entry.record.kind === 'project' && <WorkFacts entry={entry} locale={locale} />}
  <div class="work-card-footer">
    {entry.developmentStatus ? <span class="work-status" data-development-status={entry.developmentStatus}>{developmentLabels[entry.developmentStatus][locale]}</span> : entry.phase && <span class="work-phase">{entry.phase}</span>}
    {entry.record.date && <time datetime={entry.record.date}>{new Intl.DateTimeFormat(zh ? 'zh-TW' : 'en', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${entry.record.date}T00:00:00Z`))}</time>}
    <span class="work-read" aria-hidden="true">{zh ? '閱讀紀錄' : 'Read record'} →</span>
  </div>
  {(entry.record.github || entry.record.demo) && <div class="work-actions work-external">{entry.record.github && <a href={entry.record.github}>GitHub <span aria-hidden="true">↗</span></a>}{entry.record.demo && <a href={entry.record.demo}>{zh ? '展示' : 'Demo'} <span aria-hidden="true">↗</span></a>}</div>}
  {related.length > 0 && <div class="work-related"><span class="meta">{zh ? '延伸閱讀' : 'Related writing'}</span>{related.map(item => <a href={localPath(item.path, item.record.locale as Locale)}>{item.title}</a>)}</div>}
</article>
