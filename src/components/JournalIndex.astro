---
import { content } from '../lib/content';
import { journalEntries, journalCategories } from '../lib/journal';
import { localPath, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const entries = journalEntries(content, locale);
---
<section data-journal-index>
  <div class="journal-filters" role="group" aria-label={zh ? '日誌主要分類' : 'Journal primary category'}>
    <button type="button" data-journal-filter="all" aria-pressed="true">{zh ? '全部' : 'All'} <span>{entries.length}</span></button>
    {Object.entries(journalCategories).map(([key, label]) => <button type="button" data-journal-filter={key} aria-pressed="false">{label.zh} / {label.en} <span>{entries.filter(entry => entry.category === key).length}</span></button>)}
  </div>
  <p class="meta" aria-live="polite" data-journal-count data-count-label={zh ? '篇文章' : 'articles'}>{entries.length} {zh ? '篇文章 · 日期由新到舊' : 'articles · newest first'}</p>
  <div class="journal-grid">{entries.map(entry => <article class="record" data-journal-category={entry.category}>
    <p class="meta">{journalCategories[entry.category][locale]}{entry.record.date && <> · <time datetime={entry.record.date}>{entry.record.date}</time></>}</p>
    <h2><a href={localPath(entry.path, entry.record.locale as Locale)} lang={entry.record.locale === 'zh' ? 'zh-TW' : 'en'}>{entry.title}</a></h2>
    <p lang={entry.record.locale === 'zh' ? 'zh-TW' : 'en'}>{entry.record.description}</p>
    {entry.record.locale !== locale && <p class="meta">{zh ? '提供原文版本' : 'Chinese original; English edition not published.'}</p>}
    {entry.tags.length > 0 && <ul class="journal-tags" aria-label={zh ? '標籤' : 'Tags'}>{entry.tags.map(tag => <li>{tag}</li>)}</ul>}
  </article>)}</div>
  <noscript><p>{zh ? '未啟用 JavaScript；以下依日期顯示全部分類。' : 'JavaScript is disabled; all categories are shown in date order.'}</p></noscript>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-journal-index]').forEach(index => {
    const buttons = index.querySelectorAll<HTMLButtonElement>('[data-journal-filter]');
    const articles = index.querySelectorAll<HTMLElement>('[data-journal-category]');
    buttons.forEach(button => button.addEventListener('click', () => {
      const category = button.dataset.journalFilter;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      let count = 0;
      articles.forEach(article => {
        article.hidden = category !== 'all' && article.dataset.journalCategory !== category;
        if (!article.hidden) count++;
      });
      const output = index.querySelector<HTMLElement>('[data-journal-count]');
      if (output) output.textContent = `${count} ${output.dataset.countLabel}`;
    }));
  });
</script>
<style>
  .journal-filters { display:flex; flex-wrap:wrap; gap:.6rem; margin-block:1.5rem; }
  button { min-height:44px; padding:.6rem .9rem; border:1px solid var(--line); border-radius:10px; background:var(--paper); color:var(--ink); cursor:pointer; font:inherit; font-size:.85rem; }
  button[aria-pressed="true"] { border-color:var(--accent); background:var(--surface); font-weight:700; }
  button:focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
  button span { margin-inline-start:.4rem; }
  .journal-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem 2rem; }
  article { min-width:0; overflow-wrap:anywhere; }
  article[hidden] { display:none; }
  h2 { font-size:1.25rem; line-height:1.5; }
  .journal-tags { display:flex; flex-wrap:wrap; gap:.5rem; padding:0; list-style:none; font-size:.75rem; color:var(--muted); }
  @media(max-width:767px) { .journal-grid { grid-template-columns:1fr; } .journal-filters button { flex:1 1 45%; } }
</style>
