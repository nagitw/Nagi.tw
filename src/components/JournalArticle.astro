---
import type { CollectionEntry } from 'astro:content';
import EditorialImage from './EditorialImage.astro';
import { showEditorialCover } from '../lib/editorial.mjs';
import JournalToc from './JournalToc.astro';
import { localizePath, translate } from '../lib/i18n';

interface Heading { depth: number; slug: string; text: string }
interface Props { entry: CollectionEntry<'journal'>; headings: Heading[] }
const { entry, headings } = Astro.props;
const { data } = entry;
const locale = data.language;
const t = (en: string, zh: string) => translate(locale, en, zh);
const journalHref = localizePath('/journal/', locale);
const dateFormat = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' });
const formatDate = (date: string) => dateFormat.format(new Date(date));
const wordCount = Array.from(new Intl.Segmenter(locale, { granularity: 'word' }).segment(entry.body ?? ''))
  .filter(segment => segment.isWordLike).length;
const minutes = Math.max(1, Math.ceil(wordCount / 220));
const kinds = {
  note: t('Note', '筆記'),
  essay: t('Essay', '文章'),
  reading: t('Reading notes', '閱讀筆記'),
};
const sections: (Heading & { children: Heading[] })[] = [];
let parent: typeof sections[number] | undefined;
for (const heading of headings) {
  if (heading.depth === 2) {
    parent = { ...heading, children: [] };
    sections.push(parent);
  } else if (heading.depth === 3) {
    if (parent) parent.children.push(heading);
    else sections.push({ ...heading, children: [] });
  } else if (heading.depth === 1) {
    parent = undefined;
  }
}
const tocLabel = t('On this page', '本頁目錄');
---
<article class="journal-article" aria-labelledby="article-title">
  <header class="journal-header">
    <nav class="eyebrow" aria-label={t('Breadcrumb', '麵包屑導覽')}>
      <ol class="journal-breadcrumb">
        <li><a href={localizePath('/', locale)}>{t('Home', '首頁')}</a></li>
        <li><a href={journalHref}>{t('Journal', '札記')}</a></li>
      </ol>
    </nav>
    <p class="eyebrow journal-kind">{kinds[data.kind]}</p>
    <h1 id="article-title">{data.title}</h1>
    {data.subtitle && <p class="intro">{data.subtitle}</p>}
    <ul class="journal-meta" aria-label={t('Article details', '文章資訊')}>
      {data.author && <li>{data.author}</li>}
      {data.publishedAt && <li>{t('Published', '發布於')} <time datetime={data.publishedAt}>{formatDate(data.publishedAt)}</time></li>}
      {data.updatedAt && <li>{t('Updated', '更新於')} <time datetime={data.updatedAt}>{formatDate(data.updatedAt)}</time></li>}
      <li>{t(`${minutes} min read`, `閱讀約 ${minutes} 分鐘`)}</li>
    </ul>
  </header>
  {data.cover && data.coverAlt && showEditorialCover(data.cover) && <EditorialImage src={data.cover} alt={data.coverAlt} caption={data.coverCaption} eager />}
  <div class="journal-reading">
    {sections.length > 0 && <JournalToc sections={sections} label={tocLabel} />}
    <div class="journal-content">
      <div class="article-prose" data-article-body><slot /></div>
      {data.references.length > 0 && <section class="journal-references article-prose" aria-labelledby="article-references">
        <h2 id="article-references">{t('References', '參考資料')}</h2>
        <ol>{data.references.map(({ label, url }) => <li><a href={url}>{label}</a></li>)}</ol>
      </section>}
    </div>
  </div>
  <footer class="journal-footer">
    {data.tags.length > 0 && <ul class="tags" aria-label={t('Tags', '標籤')}>{data.tags.map(tag => <li>{tag}</li>)}</ul>}
    <a class="text-link" href={journalHref}>{t('← Back to Journal', '← 回到札記')}</a>
  </footer>
</article>
