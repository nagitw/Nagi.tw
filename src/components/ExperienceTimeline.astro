---
import type { PublicEntry } from '../lib/content';
import { groupExperience, experienceType } from '../lib/experience-timeline';
import { translate, localizePath, type Locale } from '../lib/i18n';
import policy from '../lib/editorial-policy.json';

interface Props { entries: PublicEntry[]; locale: Locale }
const { entries, locale } = Astro.props;
const groups = groupExperience(entries.filter(entry => entry.collection === 'experience'));
const t = (en: string, zh: string) => translate(locale, en, zh);
const articles: Record<string, string> = { 'tatung-workshop': '/journal/ctf-meets-malware-analysis-windows/', 'infosec-2026': '/journal/infosec-taiwan-2026-student-industry-gap/' };
const formatDate = (date: string) => date.replaceAll('-', '.');
const eventDates: Record<string, { value: string; end?: string }> = policy.eventDates;
const eventResults: Record<string, Partial<Record<Locale, string>>> = policy.eventResults;
const eventStages: Record<string, Partial<Record<Locale, string>>> = policy.eventStages;
---
<div class="experience-timeline">
  {groups.map((group, index) => <details class="timeline-year" open={index === 0}>
    <summary id={`experience-year-${group.year}`}><h3>{group.year}</h3></summary>
    <ol class="timeline-events">
      {group.entries.map(({ data }) => {
        const article = articles[data.slug];
        const result = eventResults[data.slug]?.[locale] ?? ((policy.competitionResultsConfirmed || policy.preserveHistoricalCompetitionResults) && data.tags.includes('competitions') ? data.description : undefined);
        return <li class="timeline-event" id={data.slug} lang={data.language} data-event-date={data.startedAt}>
          <article>
            <h4>{data.title}</h4>
            <p class="timeline-meta">
              {eventDates[data.slug] && <><time datetime={data.startedAt}>{formatDate(data.startedAt)}</time>
              {data.startedAt.length === 10 && data.endedAt?.length === 10 && data.endedAt !== data.startedAt && <> — <time datetime={data.endedAt}>{formatDate(data.endedAt)}</time></>} · </>}
              <span>{experienceType(data.slug, locale)}</span>
              {eventStages[data.slug] && <span> · {eventStages[data.slug][locale]}</span>}
            </p>
            {result && <p class="timeline-summary">{result}</p>}
            {article && <a class="timeline-article" href={localizePath(article, locale)}>{t('Read article', '閱讀文章')} ↗</a>}
          </article>
        </li>;
      })}
    </ol>
  </details>)}
</div>
<style is:inline>
  .timeline-note { max-inline-size: var(--measure); margin-block: 0 2rem; }
  .experience-timeline { margin-inline-start: .25rem; padding-inline-start: 1.5rem; border-inline-start: 1px solid var(--line); max-inline-size: var(--shell); }
  .timeline-year + .timeline-year { margin-block-start: clamp(2rem, 5vw, 4rem); }
  .timeline-year summary { cursor: pointer; padding-block: .5rem; margin-block-end: 1.5rem; }
  .timeline-year h3 { display: inline; margin: 0; font-family: var(--serif); font-size: clamp(1.5rem, 3vw, 2rem); }
  .timeline-year:not([open]) summary { margin-block-end: 0; }
  .timeline-events, .timeline-links { list-style: none; padding: 0; margin: 0; }
  .timeline-event { position: relative; padding-block-end: clamp(1.75rem, 4vw, 3rem); scroll-margin-block-start: 2rem; }
  .timeline-event:last-child { padding-block-end: .5rem; }
  .timeline-event::before { content: ''; position: absolute; inset-inline-start: calc(-1.5rem - .25rem - .5px); inset-block-start: .5rem; inline-size: .5rem; block-size: .5rem; border: 1px solid var(--ink); border-radius: 50%; background: var(--bg); }
  .timeline-event h4 { margin: 0; font-family: var(--serif); font-size: clamp(1.15rem, 2vw, 1.5rem); line-height: 1.35; overflow-wrap: anywhere; }
  .timeline-meta { color: var(--secondary); font-family: var(--mono); font-size: .8rem; margin-block: .65rem; }
  .timeline-summary { max-inline-size: var(--measure); margin-block: .65rem; overflow-wrap: anywhere; }
  .timeline-links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; font-size: .85rem; }
  .timeline-links a { display: inline-flex; align-items: center; min-block-size: 2.75rem; overflow-wrap: anywhere; }
</style>
