---
import { readingMinutes } from '../lib/article';
import type { Locale } from '../i18n/ui';
interface Props { body?: string; date?: string; category?: string; locale: Locale }
const { body, date, category, locale } = Astro.props;
---
<p class="reading-meta meta">
  {category && <span>{category}</span>}
  {date && <time datetime={date}>{date}</time>}
  <span data-reading-time>{locale === 'zh' ? `約 ${readingMinutes(body ?? '')} 分鐘閱讀（估算）` : `${readingMinutes(body ?? '')} min read (estimated)`}</span>
</p>
