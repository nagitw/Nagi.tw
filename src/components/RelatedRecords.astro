---
import { relatedEntries } from '../lib/catalog';
import { content } from '../lib/content';
import { localPath, type Locale } from '../i18n/ui';
interface Props { path: string; locale: Locale }
const { path, locale } = Astro.props;
const entries = relatedEntries(content, path, locale);
---
{entries.length > 0 && <section class="related-records" aria-label={locale === 'zh' ? '相關閱讀' : 'Related reading'}>
  <h2>{locale === 'zh' ? '延伸閱讀' : 'Continue exploring'}</h2>
  <ul>{entries.map(entry => <li><span class="meta">{entry.typeLabel}</span><a href={localPath(entry.path, entry.record.locale as Locale)} lang={entry.record.locale === 'zh' ? 'zh-TW' : 'en'}>{entry.title} <span aria-hidden="true">→</span></a>{entry.record.locale !== locale && <small>{locale === 'zh' ? '英文原文' : 'Chinese original'}</small>}</li>)}</ul>
</section>}
