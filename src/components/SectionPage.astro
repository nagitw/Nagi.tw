---
import Layout from '../layouts/Layout.astro';
import ContentCard from '../components/ContentCard.astro';
import AboutProfile from './AboutProfile.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import ResearchDirections from './ResearchDirections.astro';
import JournalFilters from './JournalFilters.astro';
import { collectionNames, getPublished, preferLocale } from '../lib/content';

import { localeFromPath, localizePath, translate } from '../lib/i18n';
const { page } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = (en: string, zh: string) => translate(locale, en, zh);
const collection = collectionNames.find((name) => name === page.slug);
const entries = collection
  ? preferLocale(await getPublished(collection), locale)
  : [];
const journalEntries =
  page.slug === 'journal'
    ? preferLocale(await getPublished('journal'), locale)
    : [];
const categories = [
  ...new Set(
    journalEntries.map(
      (entry) =>
        entry.data.category ??
        (entry.data.kind === 'note'
          ? t('Notes', '筆記')
          : entry.data.kind === 'essay'
            ? t('Essays', '文章')
            : t('Reading', '閱讀')),
    ),
  ),
];
const tags = [
  ...new Set(journalEntries.flatMap((entry) => entry.data.tags)),
].sort();
---

<Layout
  title={t(page.title, page.zhTitle)}
  description={t(page.description, page.zhDescription)}
>
  {page.slug === 'about' ? (
    <AboutProfile />
  ) : (
    <>
      <div class="page-header">
        <h1>{t(page.title, page.zhTitle)}</h1>
        <p class="page-subtitle">{t(page.subtitle, page.zhSubtitle)}</p>
        <p class="intro">{t(page.description, page.zhDescription)}</p>
      </div>
      <section class="section" aria-labelledby="content-title">
        {page.slug === 'research' && (
          <>
            <ResearchDirections locale={locale} />
            <p class="intro">
              {t(
                'These are areas of interest. Public work below records its own scope and stage; no completed study or publication is implied.',
                '以上為研究方向。下方公開紀錄各自標示範圍與階段，不代表已完成研究或發表論文。',
              )}
            </p>
          </>
        )}
        {page.slug === 'journal' && (
          <>
            <a class="text-link" href={localizePath('/search/', locale)}>
              {t('Full-text search', '全文搜尋')}
            </a>
            <JournalFilters
              locale={locale}
              categories={categories}
              tags={tags}
            />
          </>
        )}
        {entries.length > 0 ? (
          <>
            <h2 id="content-title">
              {t(page.title + ' collection', page.zhTitle + '選集')}
            </h2>
            {page.slug === 'experience' ? (
              <>
                <div
                  class="rankings"
                  aria-label={t('Confirmed CTF rankings', '已確認 CTF 排名')}
                >
                  <p>
                    <strong>BroncoCTF</strong>
                    <span>49 / 3307</span>
                  </p>
                  <p>
                    <strong>Junior.Crypt</strong>
                    <span>147 / 1613</span>
                  </p>
                  <p>
                    <strong>K17 CTF</strong>
                    <span>55 / 1450</span>
                  </p>
                  <p>
                    <strong>picoCTF</strong>
                    <span>1007 / 8748</span>
                  </p>
                </div>
                <ExperienceTimeline entries={entries} locale={locale} />
              </>
            ) : (
              <div class="work-list">
                {entries.map((entry) => (
                  <div
                    data-journal-entry={page.slug === 'journal' || undefined}
                    data-category={
                      entry.collection === 'journal'
                        ? (entry.data.category ??
                          (entry.data.kind === 'note'
                            ? t('Notes', '筆記')
                            : entry.data.kind === 'essay'
                              ? t('Essays', '文章')
                              : t('Reading', '閱讀')))
                        : undefined
                    }
                    data-tags={JSON.stringify(entry.data.tags)}
                  >
                    <ContentCard entry={entry} />
                  </div>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class={page.slug === 'about' ? 'about-copy' : 'empty-state'}>
            <h2 id="content-title">{t(page.heading, page.zhHeading)}</h2>
            <p>{t(page.note, page.zhNote)}</p>
          </div>
        )}
        <a class="text-link" href={localizePath('/', locale)}>
          {t('← Back to home', '← 回到首頁')}
        </a>
      </section>
    </>
  )}
</Layout>
