---
import { localeFromPath, translate, withBase } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const label = translate(locale, 'Pause penguin animation', '暫停企鵝動畫');
---

<div class="mascot" data-mascot>
  <button
    type="button"
    aria-label={label}
    aria-pressed="false"
    data-penguin-toggle
  >
    <img
      src={withBase('/nagi-penguin.svg')}
      width="32"
      height="32"
      alt={translate(
        locale,
        'Nagi’s original penguin mascot',
        'Nagi 原創企鵝吉祥物',
      )}
    />
  </button>
  <span>{translate(locale, 'A curious companion.', '保持好奇的小夥伴。')}</span>
</div>
<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-penguin-toggle]')
    .forEach((button) => {
      try {
        button.setAttribute(
          'aria-pressed',
          String(localStorage.getItem('nagi-penguin-paused') === 'true'),
        );
      } catch {
        /* optional storage */
      }
      button.addEventListener('click', () => {
        const paused = button.getAttribute('aria-pressed') !== 'true';
        button.setAttribute('aria-pressed', String(paused));
        try {
          localStorage.setItem('nagi-penguin-paused', String(paused));
        } catch {
          /* optional storage */
        }
      });
    });
</script>
