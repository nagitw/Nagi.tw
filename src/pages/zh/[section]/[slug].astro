---
import { showEditorialCover } from '../../../lib/editorial.mjs';
import { withBase } from '../../../lib/i18n';
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import EditorialImage from '../../../components/EditorialImage.astro';
import JournalArticle from '../../../components/JournalArticle.astro';
import { detailCollections, getPublished, type DetailCollection } from '../../../lib/content';
import { sections } from '../../../lib/sections';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const collections = await Promise.all(detailCollections.map(collection => getPublished(collection)));
  return collections.flatMap(entries => entries.filter(entry => entry.data.language === "zh-TW").map(entry => ({
    params: { section: entry.collection, slug: entry.data.slug },
    props: { entry, hasTranslation: entries.some(candidate => candidate.data.slug === entry.data.slug && candidate.data.language !== entry.data.language) },
  })));
}
interface Props { entry: CollectionEntry<DetailCollection>; hasTranslation: boolean }
const { entry, hasTranslation } = Astro.props;
const { data } = entry;
const sectionTitle = sections.find(section => section.slug === entry.collection)?.zhTitle ?? entry.collection;
const { Content, headings } = await render(entry);
---
<Layout title={data.title} description={data.description} contentLanguage={data.language} hasTranslation={hasTranslation}>
  {entry.collection === 'journal' ? <JournalArticle entry={entry} headings={headings}><Content /></JournalArticle> : <article>
    <div class="page-header">
      <a class="eyebrow" href={withBase(`/zh/${entry.collection}/`)}>← {sectionTitle}</a>
      <h1>{data.title}</h1>
      <p class="intro">{data.description}</p>
      {data.publishedAt && <p class="muted">發布於 <time datetime={data.publishedAt}>{data.publishedAt}</time>{data.updatedAt && <> · 更新 <time datetime={data.updatedAt}>{data.updatedAt}</time></>}</p>}
      {data.tags.length > 0 && <ul class="tags" aria-label="標籤">{data.tags.map(tag => <li>{tag}</li>)}</ul>}
    </div>
    {data.cover && data.coverAlt && showEditorialCover(data.cover) && <EditorialImage src={data.cover} alt={data.coverAlt} caption={data.coverCaption} eager />}
    <section class="section content-body">
      {entry.collection === 'projects' && <dl class="content-meta">{entry.data.role && <><dt>角色</dt><dd>{entry.data.role}</dd></>}{entry.data.tools.length > 0 && <><dt>工具</dt><dd>{entry.data.tools.join(' / ')}</dd></>}{entry.data.projectUrl && <><dt>專案</dt><dd><a href={entry.data.projectUrl}>查看專案 ↗</a></dd></>}{entry.data.repositoryUrl && <><dt>原始碼</dt><dd><a href={entry.data.repositoryUrl}>原始碼 ↗</a></dd></>}</dl>}
      {entry.collection === 'research' && <dl class="content-meta">{entry.data.question && <><dt>問題</dt><dd>{entry.data.question}</dd></>}{entry.data.methods.length > 0 && <><dt>方法</dt><dd>{entry.data.methods.join(' / ')}</dd></>}</dl>}
      {entry.collection === 'photography' && <p class="muted"><time datetime={entry.data.takenAt}>{entry.data.takenAt}</time>{entry.data.location && ` · ${entry.data.location}`}</p>}
      <div class="prose"><Content /></div>
      {entry.collection === 'photography' && <div class="photo-gallery">{entry.data.images.map(photo => <EditorialImage src={photo.src} alt={photo.alt} caption={photo.caption} />)}</div>}
      {entry.collection === 'research' && entry.data.sources.length > 0 && <aside class="prose"><h2>參考來源</h2><ul>{entry.data.sources.map(source => <li><a href={source}>{source}</a></li>)}</ul></aside>}
      <a class="text-link" href={withBase(`/zh/${entry.collection}/`)}>← 回到{sectionTitle}</a>
    </section>
  </article>}
</Layout>
