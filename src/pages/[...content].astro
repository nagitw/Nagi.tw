---
interface Props { locale: 'en' | 'zh'; path: string; disclosure: boolean; id?: string; year?: string }
import Article from '../views/Article.astro';
import Disclosures from '../views/Disclosures.astro';
import { content } from '../lib/content';
import { publicDisclosures } from '../data/disclosures';
import { getPublicDisclosures } from '../lib/disclosures';
export function getStaticPaths() {
 const records = getPublicDisclosures(publicDisclosures);
 const disclosures = [{ path: '/security/disclosures/' }, ...records.map(r => ({ path: `/security/disclosures/${r.id}/`, id: r.id })), ...[...new Set(records.map(r => r.year))].map(year => ({ path: `/security/disclosures/year/${year}/`, year }))];
 return ['en', 'zh'].flatMap(locale => [
 ...content.filter(record => record.locale === locale).map(record => ({params:{content: record.route.slice(1,-1)},props:{locale,path:record.route.replace(/^\/zh(?=\/)/, ''),disclosure:false}})),
 ...disclosures.map(item => ({params:{content: `${locale === 'zh' ? 'zh/' : ''}${item.path.slice(1,-1)}`},props:{locale,...item,disclosure:true}}))]);
}
const { locale, path, disclosure, id, year } = Astro.props;
---
{disclosure ? <Disclosures locale={locale} id={id} year={year} /> : <Article locale={locale} path={path} />}
