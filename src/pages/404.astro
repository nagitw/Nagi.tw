---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>404 — Page not found · Nagi.tw</title>
    <meta name="description" content="Page not found. Return to Nagi.tw. 找不到此頁面，請返回首頁。" />
    <link rel="icon" type="image/svg+xml" href={`${base}nagi-penguin.svg`} />
  </head>
  <body>
    <main id="main">
      <h1>404 — Page not found</h1>
      <p>This page could not be found.</p>
      <p lang="zh-TW">找不到此頁面，請返回首頁。</p>
      <nav aria-label="Return home">
        <a href={base}>English home</a>
        <a href={`${base}zh/`} lang="zh-TW">中文首頁</a>
      </nav>
    </main>
  </body>
</html>
<style>
  main { max-width: 40rem; margin: 15vh auto; padding: 1.5rem; overflow-wrap: anywhere; }
  nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
</style>
