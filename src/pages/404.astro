---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout locale="zh" availableLocales={[]} noindex title="404 — Page not found" description="找不到此頁面，請返回首頁。 Page not found. Return to Nagi.tw.">
  <header class="page-heading"><p class="eyebrow">Nagi.tw / 404</p><h1>404 — 找不到此頁面</h1><p lang="en">This page could not be found.</p><p>找不到此頁面，請返回首頁。</p></header>
  <nav class="error-links" aria-label="Return home"><a href={`${base}zh/`} lang="zh-TW">中文首頁</a><a href={base} lang="en">English home</a></nav>
</BaseLayout>
<style>.error-links { display:flex; flex-wrap:wrap; gap:1.5rem; } .error-links a { min-height:44px; }</style>
