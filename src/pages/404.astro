---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/i18n';
---

<Layout
  title="404 · Page not found"
  description="Page not found. Return home to continue exploring."
  noindex
>
  <section class="hero">
    <p class="eyebrow">404 / Page not found</p>
    <h1>A quiet detour.</h1>
    <p class="intro">This page does not exist or has moved.</p>
    <a class="text-link" href={withBase('/')}>
      Back to home ↗
    </a>
  </section>
</Layout>
