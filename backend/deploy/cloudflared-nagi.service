[Unit]
Description=Nagi dedicated outbound Cloudflare Tunnel
After=network-online.target nagi-ai.service
Wants=network-online.target

[Service]
User=cloudflared-nagi
Group=cloudflared-nagi
ExecStart=/usr/bin/cloudflared --config /etc/cloudflared-nagi/config.yml tunnel run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
