{
  "name": "nagi.tw",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test:schema": "node scripts/content-schema.test.mjs",
    "test:content": "node scripts/content-integration.test.mjs",
    "test:content:prepare": "node scripts/content-integration.test.mjs prepare",
    "test:content:cleanup": "node scripts/content-integration.test.mjs cleanup",
    "test:content:empty": "node scripts/content-integration.test.mjs empty",
    "check": "astro check",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "dev": "astro dev",
    "build": "astro build --force && node scripts/v4-search.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test:i18n": "node scripts/i18n.test.mjs",
    "test:penguin": "node scripts/penguin.test.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "lint": "eslint src scripts/v4-*.mjs tests/v4 playwright.config.ts eslint.config.mjs",
    "format:check": "prettier --check src/components src/layouts src/pages src/styles src/lib src/scripts scripts/v4-*.mjs tests/v4 playwright.config.ts eslint.config.mjs",
    "verify:v4": "node scripts/v4-inventory.mjs && node scripts/v4-contract.test.mjs && node scripts/v4-links.mjs",
    "test:v4": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.3.1",
    "lighthouse": "^13.6.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
