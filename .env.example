# Mock is the default. Never place API keys or private credentials in PUBLIC_*.
PUBLIC_PENGUIN_AI_MODE=mock
# Only set after independently deploying and reviewing the public AI endpoint.
# PUBLIC_PENGUIN_API_BASE_URL=https://your-public-api.example
# POST /chat is appended. Legacy exact PUBLIC_PENGUIN_API_URL is also supported.
# Optional Pages repository prefix; custom domain nagi.tw uses /.
# SITE_BASE=/repository/
