# Offline is the default. Mock uses prepared public answers without a backend.
# Never place API keys or private credentials in PUBLIC_*.
PUBLIC_PENGUIN_AI_MODE=offline
# Only set after independently deploying and reviewing the public AI endpoint.
# PUBLIC_PENGUIN_AI_MODE=api
# Exact public POST endpoint (no credentials, query or custom port).
# PUBLIC_PENGUIN_API_URL=https://api.nagi.tw/chat
# GitHub Pages settings (custom domain: SITE_URL=https://nagi.tw, SITE_BASE=/).
SITE_URL=https://seraphforge.github.io
SITE_BASE=/nagi.tw/
